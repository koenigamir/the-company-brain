ANTHROPIC_API_KEY=sk-ant-your-key-here

# Persistence: local JSON under ./localstore (default).
# To use Supabase instead, uncomment and set all three:
# SUPABASE_ENABLED=true
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key

# Image ingestion (vision OCR via Claude). Defaults to the synthesis model.
VISION_MODEL=claude-sonnet-4-6

# Audio / video transcription (local faster-whisper).
WHISPER_MODEL=small
TRANSCRIBE_MIN_CONF=0.5
# Optional cloud escalation when local confidence is low (pick one):
# OPENAI_API_KEY=sk-...                 # uses OpenAI audio transcription
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION + TRANSCRIBE_S3_BUCKET  # AWS Transcribe
