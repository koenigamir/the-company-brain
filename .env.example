ANTHROPIC_API_KEY=sk-ant-your-key-here

# Streamlit-to-backend mode. Leave unset to run Streamlit in local in-process mode.
COMPANY_BRAIN_API_URL=http://localhost:8000

# Runtime artifact paths. In AWS these should point at the EFS mount.
COMPANY_BRAIN_DATA_DIR=data
COMPANY_BRAIN_CHROMA_DIR=chroma_db
COMPANY_BRAIN_GRAPH_PATH=graph.json
COMPANY_BRAIN_STORE_DIR=localstore

# Persistence: local JSON under COMPANY_BRAIN_STORE_DIR by default.
# To use Supabase instead, uncomment and set all three:
# SUPABASE_ENABLED=true
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key

# Image ingestion (vision OCR via Claude). Defaults to the synthesis model.
VISION_MODEL=claude-sonnet-4-6

# Audio / video transcription (local faster-whisper).
WHISPER_MODEL=small
TRANSCRIBE_MIN_CONF=0.5

# Optional cloud escalation when local confidence is low.
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# AWS_REGION=eu-central-1
# TRANSCRIBE_S3_BUCKET=your-transcribe-bucket
